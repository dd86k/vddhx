name "vddhx"
description "Graphical ddhx"
authors "dd86k <dd@dax.moe>"
copyright "Copyright © 2026, dd86k <dd@dax.moe>"
license "MIT"

dependency "bindbc-sdl" version="==2.4.4"
dependency "ddui" repository="git+https://github.com/dd86k/ddui.git" version="b89172370942af639af8625a3f5a3978166f47a4"
dependency "ddlogger" repository="git+https://github.com/dd86k/ddlogger.git" version="dcab663a80d496c1d3c7fee4c406ed7f763e5fdb"
dependency "ddhx" repository="git+https://github.com/dd86k/ddhx.git" version="0bfad84e39ce8bf48667fdaa163d00100a3ae789"

# Windows: GUI subsystem (--console attaches one, see source/main.d).
# D main is wmain under LDC, main under DMD.
lflags "/SUBSYSTEM:WINDOWS" platform="windows"
lflags "/ENTRY:wmainCRTStartup" platform="windows-ldc"
lflags "/ENTRY:mainCRTStartup" platform="windows-dmd"

# bindbc-sdl's baseline is SDL 3.2.0
versions "SDL_TTF_3_2_2"

# Embedded last-resort font (source/render.d)
stringImportPaths "assets/fonts"

# dub build             # SDL3 loaded at runtime (source/loader.d)
# dub build -c static   # SDL3 linked in, nothing to install
configuration "application" {
	targetType "executable"
	mainSourceFile "source/main.d"

	subConfiguration "bindbc-sdl" "dynamic"
}

configuration "static" {
	targetType "executable"
	mainSourceFile "source/main.d"

	subConfiguration "bindbc-sdl" "static"

	// Posix: from tools/build-sdl3.d, in ~/.local (wins over system libs).
	// Order matters: harfbuzz/freetype after SDL3_ttf. build-sdl3.d warns when
	// sdl3.pc lists a lib missing here.
	libs "SDL3_ttf" "harfbuzz" "freetype" "SDL3" platform="posix"
	lflags "-L$HOME/.local/lib" platform="posix"

	// Windows: from tools/build-sdl3.d, in ./install. MSVC names the static
	// libs *-static.lib. Order matters: SDL3_ttf, harfbuzz, freetype, then SDL3
	// and its system deps (from sdl3.pc; usp10, rpcrt4 for harfbuzz).
	libs "SDL3_ttf-static" "harfbuzz" "freetype" \
	     "SDL3-static" \
	     "kernel32" "user32" "gdi32" "winmm" "imm32" "ole32" "oleaut32" \
	     "version" "uuid" "advapi32" "setupapi" "shell32" "dinput8" \
	     "usp10" "rpcrt4" \
	     platform="windows"
	lflags "/LIBPATH:$PACKAGE_DIR/install/lib" platform="windows"
}

// Debug frame capture: Ctrl+Shift+F12 and --screenshot (source/screenshots.d).
// A buildType so it composes with configurations:
// `dub build -c static -b screenshots`
buildType "screenshots" {
	versions "Screenshots"
	buildOptions "debugMode" "debugInfo"
}
